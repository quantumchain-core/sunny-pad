# Replace every deployment placeholder after generating the program keypair and choosing addresses.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_TREASURY_WALLET=
NEXT_PUBLIC_COMPETITION_VAULT=
NEXT_PUBLIC_SUNNY_MINT=

# Supabase cache (optional during local UI development)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep service-role keys server-side only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=

# Optional metadata hosting; do not expose a Pinata JWT in a NEXT_PUBLIC variable.
PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud
NEXT_PUBLIC_SITE_URL=http://localhost:3000
